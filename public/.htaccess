# AIFEC — todo lo que no sea un fichero que exista lo atiende index.php.
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>

# Los recursos publicados llevan su versión en la ruta: se pueden guardar un año.
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|mjs|svg|png|jpe?g|webp|avif|gif|ico|woff2?|ttf)$">
Header set Cache-Control "public, max-age=31536000, immutable"
Header set X-Content-Type-Options "nosniff"
</FilesMatch>
</IfModule>

<FilesMatch "^(aifec-root\.php|\.htaccess)$">
Require all denied
</FilesMatch>
