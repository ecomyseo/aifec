{
    "name": "Atelier",
    "version": "1.0.0",
    "description": "Editorial fashion theme: centred logo, full-width campaign, asymmetric category mosaic, borderless portrait cards, filter row without sidebar and a sticky buy column beside a two-column gallery.",
    "parent": "base",
    "css": "replace",
    "image_sizes": {"thumb": [160, 160], "card": [600, 800], "large": [1400, 1400]},
    "font_stacks": {
        "didone": "Didot, 'Bodoni MT', 'Bodoni 72', 'Playfair Display', 'Iowan Old Style', Georgia, 'Times New Roman', serif",
        "fine": "'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, 'Times New Roman', serif"
    },
    "settings": {
        "colors": {"label": "Colours", "fields": {
            "bg": {"type": "color", "label": "Page background", "default": "#ffffff", "var": "--bg"},
            "surface": {"type": "color", "label": "Cards and panels", "default": "#ffffff", "var": "--surface"},
            "ink": {"type": "color", "label": "Text", "default": "#141414", "var": "--ink"},
            "muted": {"type": "color", "label": "Secondary text", "default": "#5e5a55", "var": "--muted"},
            "line": {"type": "color", "label": "Borders", "default": "#e4e0da", "var": "--line"},
            "accent": {"type": "color", "label": "Accent colour", "default": "#8a5a35", "var": "--accent"},
            "accent_ink": {"type": "color", "label": "Text on the accent colour", "default": "#ffffff", "var": "--accent-ink"},
            "sale": {"type": "color", "label": "Offers", "default": "#a3231b", "var": "--sale"},
            "ok": {"type": "color", "label": "Success", "default": "#2d6a48", "var": "--ok"},
            "warn": {"type": "color", "label": "Warning", "default": "#7a5200", "var": "--warn"},
            "bad": {"type": "color", "label": "Error", "default": "#a3231b", "var": "--bad"}
        }},
        "typography": {"label": "Typography", "fields": {
            "font": {"type": "font", "label": "Body font", "default": "system", "var": "--font", "options": {"system": "System", "serif": "Serif", "rounded": "Rounded", "mono": "Monospace", "didone": "Didone", "fine": "Fine serif"}},
            "font_head": {"type": "font", "label": "Headings font", "default": "fine", "var": "--font-head", "options": {"system": "System", "serif": "Serif", "rounded": "Rounded", "mono": "Monospace", "didone": "Didone", "fine": "Fine serif"}},
            "font_size": {"type": "number", "label": "Base text size", "default": 15, "min": 14, "max": 20, "unit": "px", "var": "--font-size"}
        }},
        "layout": {"label": "Layout", "fields": {
            "radius": {"type": "number", "label": "Corner radius", "default": 0, "min": 0, "max": 24, "unit": "px", "var": "--radius"},
            "container": {"type": "number", "label": "Page width", "default": 1440, "min": 960, "max": 1600, "unit": "px", "var": "--container"},
            "header_style": {"type": "select", "label": "Header", "options": {"classic": "Classic", "centered": "Centred"}, "default": "centered"},
            "card_ratio": {"type": "select", "label": "Product card image", "options": {"square": "Square", "portrait": "Portrait", "tall": "Tall"}, "default": "portrait"},
            "show_brand_in_card": {"type": "toggle", "label": "Show the brand in product cards", "default": 0}
        }},
        "structure": {"label": "Structure", "fields": {
            "strip_show": {"type": "toggle", "label": "Show the notice strip", "default": 1},
            "strip_text": {"type": "text", "label": "Notice strip text", "default": ""},
            "mega_menu": {"type": "toggle", "label": "Wide menu with columns", "default": 1},
            "mosaic_side": {"type": "select", "label": "Large category tile", "options": {"left": "Left", "right": "Right"}, "default": "left"},
            "gallery_style": {"type": "select", "label": "Product gallery", "options": {"grid": "Thumbnails beside the photo", "column": "Thumbnails below the photo"}, "default": "grid"},
            "listing_cols": {"type": "select", "label": "Product list columns", "options": {"4": "Four", "3": "Three"}, "default": "4"}
        }},
        "campaign": {"label": "Campaign", "fields": {
            "hero_image": {"type": "image", "label": "Campaign image", "default": ""},
            "hero_height": {"type": "select", "label": "Campaign height", "options": {"tall": "Tall", "medium": "Medium"}, "default": "tall"},
            "hero_kicker": {"type": "text", "label": "Campaign kicker", "default": ""},
            "hero_title": {"type": "text", "label": "Campaign title", "default": ""},
            "hero_text": {"type": "text", "label": "Campaign text", "default": ""},
            "hero_cta": {"type": "text", "label": "Campaign button text", "default": ""},
            "hero_link": {"type": "text", "label": "Campaign button link", "default": ""}
        }},
        "editorial": {"label": "Editorial block", "fields": {
            "editorial_show": {"type": "toggle", "label": "Show the editorial block", "default": 1},
            "editorial_image": {"type": "image", "label": "Editorial image", "default": ""},
            "editorial_title": {"type": "text", "label": "Editorial title", "default": ""},
            "editorial_text": {"type": "text", "label": "Editorial text", "default": ""},
            "editorial_cta": {"type": "text", "label": "Editorial button text", "default": ""},
            "editorial_link": {"type": "text", "label": "Editorial button link", "default": ""}
        }}
    }
}
