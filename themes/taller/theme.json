{
    "name": "Taller",
    "version": "1.0.0",
    "description": "Dense, practical theme for DIY and hardware shops: two-row header with a big search box, dark category bar, icon category grid, compact product cards with three key features, technical filter sidebar with a grid/list switch, and a product page with vertical thumbnails and a full-width specification table.",
    "parent": "base",
    "css": "replace",
    "image_sizes": {"thumb": [160, 160], "card": [420, 420], "large": [1200, 1200]},
    "font_stacks": {
        "condensed": "Bahnschrift, 'DIN Alternate', 'Roboto Condensed', 'Arial Narrow', 'Franklin Gothic Medium', Arial, sans-serif",
        "workshop": "'Segoe UI', 'Helvetica Neue', Roboto, Arial, sans-serif"
    },
    "settings": {
        "colors": {"label": "Colours", "fields": {
            "bg": {"type": "color", "label": "Page background", "default": "#f1f2f3", "var": "--bg"},
            "surface": {"type": "color", "label": "Cards and panels", "default": "#ffffff", "var": "--surface"},
            "ink": {"type": "color", "label": "Text", "default": "#1d2125", "var": "--ink"},
            "muted": {"type": "color", "label": "Secondary text", "default": "#545c64", "var": "--muted"},
            "line": {"type": "color", "label": "Borders", "default": "#d2d7dc", "var": "--line"},
            "accent": {"type": "color", "label": "Accent colour", "default": "#ffc20e", "var": "--accent"},
            "accent_ink": {"type": "color", "label": "Text on the accent colour", "default": "#1d2125", "var": "--accent-ink"},
            "link": {"type": "color", "label": "Links", "default": "#7a5200", "var": "--link"},
            "dark": {"type": "color", "label": "Carbon (menu bar and footer)", "default": "#1d2125", "var": "--dark"},
            "sale": {"type": "color", "label": "Offers", "default": "#c4122f", "var": "--sale"},
            "ok": {"type": "color", "label": "Success", "default": "#1b7a3d", "var": "--ok"},
            "warn": {"type": "color", "label": "Warning", "default": "#8a5a00", "var": "--warn"},
            "bad": {"type": "color", "label": "Error", "default": "#b3261e", "var": "--bad"}
        }},
        "typography": {"label": "Typography", "fields": {
            "font": {"type": "font", "label": "Body font", "default": "workshop", "var": "--font", "options": {"system": "System", "workshop": "Workshop", "condensed": "Condensed", "mono": "Monospace"}},
            "font_head": {"type": "font", "label": "Headings font", "default": "condensed", "var": "--font-head", "options": {"system": "System", "workshop": "Workshop", "condensed": "Condensed", "mono": "Monospace"}},
            "font_size": {"type": "number", "label": "Base text size", "default": 15, "min": 14, "max": 20, "unit": "px", "var": "--font-size"}
        }},
        "layout": {"label": "Layout", "fields": {
            "radius": {"type": "number", "label": "Corner radius", "default": 4, "min": 0, "max": 12, "unit": "px", "var": "--radius"},
            "container": {"type": "number", "label": "Page width", "default": 1320, "min": 960, "max": 1600, "unit": "px", "var": "--container"},
            "show_brand_in_card": {"type": "toggle", "label": "Show the brand in product cards", "default": 1}
        }},
        "structure": {"label": "Structure", "fields": {
            "header_phone": {"type": "toggle", "label": "Show the help phone in the header", "default": 1},
            "cart_amount": {"type": "toggle", "label": "Show the cart amount in the header", "default": 1},
            "nav_bar": {"type": "select", "label": "Category bar", "options": {"dark": "Carbon", "yellow": "Yellow"}, "default": "dark"},
            "listing_cols": {"type": "select", "label": "Product list columns", "options": {"4": "Four", "3": "Three"}, "default": "4"},
            "listing_view": {"type": "select", "label": "Product list view", "options": {"grid": "Grid", "list": "List"}, "default": "grid"},
            "card_specs": {"type": "select", "label": "Features in product cards", "options": {"3": "Three", "2": "Two", "0": "None"}, "default": "3"},
            "gallery_thumbs": {"type": "select", "label": "Product thumbnails", "options": {"side": "Vertical, beside the photo", "below": "Below the photo"}, "default": "side"}
        }},
        "home": {"label": "Home page", "fields": {
            "home_title": {"type": "text", "label": "Home page title", "default": ""},
            "home_text": {"type": "text", "label": "Home page text", "default": ""},
            "brands_show": {"type": "toggle", "label": "Show the brands strip", "default": 1},
            "perks_show": {"type": "toggle", "label": "Show the service icons row", "default": 1},
            "tips_show": {"type": "toggle", "label": "Show the latest tips from the blog", "default": 1}
        }}
    }
}
